# What the image does not need. Runtime data and secrets of a used checkout
# must never enter it (CI plants sentinels to check).

# runtime data, secrets and local settings
data
backups
**/*.sqlite3*
**/*.log
**/*.log.*
**/*.bak
**/*~
**/*.swp
**/*.swo
**/console/cert.pem*
**/dhcpd.*
webvirtcloud/settings.py
# the copy the README has Docker users keep next to the compose file
settings.py
**/staticfiles

# virtualenvs, caches and editor files
**/venv*
**/.venv*
**/env*
**/.env*
**/__pycache__
**/*.py[cod]
**/.ruff_cache
**/.pytest_cache
**/.coverage*
**/htmlcov
**/.idea
**/.vscode
**/.DS_Store
**/.vagrant

# repository, CI, docs and the other ways to install
.git
.gitignore
.github
.hadolint.yaml
.dockerignore
Dockerfile
docker-compose*.yml
_config.yml
pyproject.toml
*.md
doc
dev
Vagrantfile
install.sh
webvirtcloud.sh
