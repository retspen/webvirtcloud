[Unit]
Description=WebVirtCloud gstfsd (root password and SSH keys of shut-off VMs)
Wants=network-online.target
After=network-online.target

[Service]
# GSTFSD_KEY, the key the panel signs with (root, mode 600)
EnvironmentFile=/etc/default/webvirt-gstfsd
ExecStart=/usr/bin/python3 /usr/local/bin/gstfsd
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
