# Database
# https://docs.djangoproject.com/en/3.0/ref/settings/#databases

# sqlite by default; PostgreSQL when WEBVIRTCLOUD_DB_HOST is set (a host name,
# an IP, or a unix socket directory).
if db_host := os.getenv("WEBVIRTCLOUD_DB_HOST"):
    DATABASES = {
        "default": {
            "ENGINE": "django.db.backends.postgresql",
            "HOST": db_host,
            "PORT": os.getenv("WEBVIRTCLOUD_DB_PORT", "5432"),
            "NAME": os.getenv("WEBVIRTCLOUD_DB_NAME", "webvirtcloud"),
            "USER": os.getenv("WEBVIRTCLOUD_DB_USER", "webvirtcloud"),
            "PASSWORD": os.getenv("WEBVIRTCLOUD_DB_PASSWORD", ""),
        }
    }
else:
    DATABASES = {
        "default": {
            "ENGINE": "django.db.backends.sqlite3",
            "NAME": Path.joinpath(BASE_DIR, "db.sqlite3"),
            # IMMEDIATE takes the write lock when a transaction starts, so a
            # check-then-write cannot interleave with another process; timeout
            # is how long a writer waits for that lock (seconds). WAL is set
            # per connection by the operations app.
            "OPTIONS": {"transaction_mode": "IMMEDIATE", "timeout": 20},
            # A file, not shared-cache memory: test threads and worker processes
            # open the same database, and shared-cache locks ignore the timeout.
            "TEST": {"NAME": os.getenv("WEBVIRTCLOUD_TEST_DB") or Path.joinpath(BASE_DIR, "test_db.sqlite3")},
        }
    }

