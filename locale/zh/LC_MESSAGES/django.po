"Pool %(name)s holds disks of the running VMs %(vms)s; shut them down first"
msgstr "存储池 %(name)s 中有运行中的虚拟机 %(vms)s 的磁盘；请先关闭它们"

#: vrtManager/storage.py:221
#, python-format
msgid ""
"VMs %(vms)s have disks in pool %(name)s by its name and would no longer "
"start; detach those disks first"
msgstr "虚拟机 %(vms)s 通过名称使用存储池 %(name)s 中的磁盘，将无法再启动；请先分离这些磁盘"

#: vrtManager/storage.py:253
#, python-format
msgid ""
"Volume %(name)s is in use: a VM's disk, a backing file or a snapshot's file"
msgstr "卷 %(name)s 正在使用中：它是虚拟机的磁盘、后备文件或快照文件"

#: vrtManager/storage.py:346
#, python-format
msgid "The running VMs %(vms)s use volume %(name)s; shut them down to copy it"
msgstr "正在运行的虚拟机 %(vms)s 使用卷 %(name)s；请先将其关闭再复制"

#: vrtManager/util.py:91
#, python-format
msgid "The XML is not valid: %(err)s"
msgstr "XML 无效：%(err)s"

#: vrtManager/util.py:93
msgid "The XML may not declare a DTD"
msgstr "XML 不能声明 DTD"

#: vrtManager/util.py:139
#, python-format
msgid "MAC address must be of the format AA:BB:CC:DD:EE:FF, was %(mac)s"
msgstr "MAC 地址的格式必须为 AA:BB:CC:DD:EE:FF，实际为 %(mac)s"

#: vrtManager/virtsecrets.py:26
msgid "A Ceph key is base64 text, as `ceph auth get-key` prints it"
msgstr "Ceph 密钥是 base64 文本，即 `ceph auth get-key` 输出的内容"

