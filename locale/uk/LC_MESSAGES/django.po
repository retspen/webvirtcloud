#: vrtManager/instance.py:2603
#, python-format
msgid "%(error)s; remove %(dest)s if it is there: %(cleanup_error)s"
msgstr "%(error)s; видаліть %(dest)s, якщо він там є: %(cleanup_error)s"

#: vrtManager/instance.py:2605
#, python-format
msgid "%(error)s; the VM may use %(dest)s now: check its disk %(dev)s"
msgstr ""
"%(error)s; ВМ може зараз використовувати %(dest)s: перевірте її диск %(dev)s"

#: vrtManager/instance.py:2612
#, python-format
msgid "The VM has no internal snapshot named %(name)s"
msgstr "ВМ не має внутрішнього знімка з назвою %(name)s"

#: vrtManager/instance.py:2623
msgid "A snapshot job is still running on this VM; try again when it ends"
