#: vrtManager/interface.py:312
#, python-format
msgid ""
"Interface %(iface)s carries the address this panel reaches the host by; "
"stopping it would cut the host off"
msgstr ""
"Інтерфейс %(iface)s має адресу, через яку панель під’єднується до хоста; його"
