msgstr "ВМ має власний TPM: змініть його в редакторі XML"

#: vrtManager/instance.py:3402
#, python-format
msgid "Unknown crash action %(action)s"
msgstr "Невідома дія у разі збою: %(action)s"

#: vrtManager/instance.py:3438
#, python-format
msgid "Network interface %(mac)s is not in the definition"
msgstr "Мережевого інтерфейсу %(mac)s немає у визначенні"

#: vrtManager/instance.py:3529
msgid "The guest agent did not answer in time; nothing was changed"
msgstr "Гостьовий агент не відповів вчасно; нічого не змінено"

#: vrtManager/instance.py:3532
msgid "The VM runs Windows: its guest agent sets no root password or SSH key"
