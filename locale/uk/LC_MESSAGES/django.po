#: vrtManager/interface.py:347
#, python-format
msgid "Stop interface %(iface)s before deleting it"
msgstr "Зупиніть інтерфейс %(iface)s перед видаленням"

#: vrtManager/interface.py:352
#, python-format
msgid ""
"Bridge %(iface)s has addresses and several members: give the addresses to one"
