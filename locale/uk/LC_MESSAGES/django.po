#: vrtManager/instance.py:2530
#, python-format
msgid "%(dev)s is in pool %(pool_name)s already"
msgstr "%(dev)s уже перебуває в пулі %(pool_name)s"

#: vrtManager/instance.py:2534
#, python-format
