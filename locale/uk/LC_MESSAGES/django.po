#: vrtManager/instance.py:1395
#, python-format
msgid "CD-ROM %(dev)s is not in the running definition"
msgstr "CD-ROM %(dev)s немає в поточному визначенні"

#: vrtManager/instance.py:1396
#, python-format
msgid "CD-ROM %(dev)s is not in the persistent definition"
msgstr "CD-ROM %(dev)s немає в постійному визначенні"

#: vrtManager/instance.py:1409
#, python-format
msgid "Media of %(dev)s changed in the running VM only: %(err)s"
msgstr "Носій %(dev)s змінено лише в запущеній ВМ: %(err)s"

#: vrtManager/instance.py:1420
#, python-format
msgid "ISO image %(image)s was not found"
msgstr "ISO-образ %(image)s не знайдено"

#: vrtManager/instance.py:1422
#, python-format
msgid "ISO image %(image)s is in more than one storage pool"
msgstr "ISO-образ %(image)s є в кількох пулах сховища"

#: vrtManager/instance.py:1432
#, python-format
msgid "ISO image %(image)s is no longer in pool %(pool)s; choose it again"
msgstr "ISO-образу %(image)s більше немає в пулі %(pool)s; виберіть його знову"

#: vrtManager/instance.py:1529
#, python-format
msgid "Disk %(target_dev)s is not in the VM's definition"
msgstr "Диска %(target_dev)s немає у визначенні ВМ"

#: vrtManager/instance.py:1661
msgid "Please shutdown the instance then try to enable vCPU hotplug"
msgstr "Вимкніть ВМ, а потім увімкніть гаряче додавання vCPU"

#: vrtManager/instance.py:1864
#, python-format
msgid ""
"The serial console is a %(type)s one, the browser opens only a pty one; "
"change it in the XML editor"
msgstr ""
"Послідовна консоль має тип %(type)s, а браузер відкриває лише консоль типу "
"pty; змініть її в редакторі XML"

#: vrtManager/instance.py:1975
msgid "The VM has no video card"
msgstr "ВМ не має відеокарти"

#: vrtManager/instance.py:1985
#, python-format
msgid ""
"The VM's CPU topology has %(count)s vCPUs: change it in the XML editor to set"
" another maximum"
msgstr ""
"Топологія CPU ВМ задає %(count)s vCPU: змініть її в редакторі XML, щоб "
"установити інший максимум"

#: vrtManager/instance.py:2011
#, python-format
msgid "The VM's next start has a maximum memory of %(max)s MiB"
msgstr "Максимальна пам’ять ВМ під час наступного запуску: %(max)s MiB"

#: vrtManager/instance.py:2152
msgid ""
"The VM has external snapshots; internal snapshots cannot be mixed with them"
msgstr "ВМ має зовнішні знімки; внутрішні знімки не можна поєднувати з ними"

#: vrtManager/instance.py:2180
msgid ""
"The VM has internal snapshots; external snapshots cannot be mixed with them"
msgstr "ВМ має внутрішні знімки; зовнішні знімки не можна поєднувати з ними"

#: vrtManager/instance.py:2185
msgid "Newer snapshots exist after the last revert; delete them first"
msgstr "Після останнього повернення існують новіші знімки; спершу видаліть їх"

#: vrtManager/instance.py:2188
msgid "No snapshot is current; revert to a snapshot first"
msgstr "Поточного знімка немає; спершу поверніться до знімка"

#: vrtManager/instance.py:2194
#, python-format
msgid "Eject the media from %(dev)s first"
msgstr "Спершу вийміть носій із %(dev)s"

#: vrtManager/instance.py:2196
#, python-format
msgid "Disk %(dev)s is not a file; external snapshots need file disks"
msgstr "Диск %(dev)s не є файлом; зовнішнім знімкам потрібні файлові диски"

#: vrtManager/instance.py:2209
msgid "A snapshot with memory is not quiesced; it keeps the whole guest state"
msgstr ""
"Знімок із пам’яттю не заморожує файлові системи; він зберігає весь стан "
"гостьової системи"

#: vrtManager/instance.py:2211
msgid "Only a running VM's file systems can be frozen"
msgstr "Заморозити можна лише файлові системи запущеної ВМ"

#: vrtManager/instance.py:2213
msgid "The QEMU guest agent is not connected; it freezes the file systems"
msgstr ""
"Гостьовий агент QEMU не під’єднаний, а саме він заморожує файлові системи"

#: vrtManager/instance.py:2222
#, python-format
msgid ""
"The storage pools could not be refreshed, so their free space is unknown: "
"%(err)s"
msgstr ""
"Не вдалося оновити пули сховища, тому їхній вільний простір невідомий: "
"%(err)s"

#: vrtManager/instance.py:2245
msgid "Memory is saved only from a running VM"
msgstr "Пам’ять зберігається лише із запущеної ВМ"

#: vrtManager/instance.py:2247
msgid "The VM has no disk to keep its memory next to"
msgstr "ВМ не має диска, поруч із яким можна зберегти її пам’ять"

#: vrtManager/instance.py:2251
#, python-format
msgid "%(disk)s is not in a storage pool; memory is saved only into one"
msgstr "%(disk)s не перебуває в пулі сховища; пам’ять зберігається лише в пул"

#: vrtManager/instance.py:2282
#, python-format
msgid ""
"Storage pool %(pool)s has %(free).1f GiB free; the snapshot needs %(size).1f "
"GiB (%(percent)g%% of the VM's disks in it, at least %(minimum)g GiB, and the"
" memory if it is saved)"
msgstr ""
"У пулі сховища %(pool)s вільно %(free).1f GiB; знімку потрібно %(size).1f GiB"
" (%(percent)g%% від дисків ВМ у ньому, щонайменше %(minimum)g GiB, а також "
"пам’ять, якщо її зберігають)"

#: vrtManager/instance.py:2300
msgid ""
"This snapshot was taken by an older version on a UEFI VM and cannot be "
"reverted; delete it instead"
msgstr ""
"Цей знімок створено старішою версією на ВМ з UEFI, і повернутися до нього "
"неможливо; натомість видаліть його"

#: vrtManager/instance.py:2330
#, python-format
msgid ""
"The revert failed twice; try again in a moment (%(error)s). The VM is "
"running."
msgstr ""
"Повернення двічі не вдалося; спробуйте ще раз за мить (%(error)s). ВМ працює."

#: vrtManager/instance.py:2332
#, python-format
msgid ""
"The revert failed twice; try again in a moment (%(error)s). The VM is shut "
"off."
msgstr ""
"Повернення двічі не вдалося; спробуйте ще раз за мить (%(error)s). ВМ "
"вимкнено."

#: vrtManager/instance.py:2500
msgid "A disk moves when its VM is defined and running, paused or shut off"
msgstr ""
"Диск переміщується, коли його ВМ визначена і працює, призупинена або вимкнена"

#: vrtManager/instance.py:2502
msgid ""
"A disk of a VM with snapshots, a saved state or a running block job does not "
"move"
msgstr ""
"Диск ВМ зі знімками, збереженим станом або запущеним блоковим завданням не "
"переміщується"

#: vrtManager/instance.py:2510
#, python-format
msgid ""
"%(dev)s is not a disk file of the VM, the same in its running and next "
"start's definition"
msgstr ""
"%(dev)s не є файлом диска ВМ, однаковим у поточному визначенні та визначенні "
"для наступного запуску"

#: vrtManager/instance.py:2515
#, python-format
msgid "%(dev)s does not move: only writable raw and qcow2 disks do"
msgstr ""
"%(dev)s не переміщується: переміщуються лише записувані диски raw і qcow2"

#: vrtManager/instance.py:2522
#, python-format
msgid "%(dev)s does not move: no storage pool has %(path)s"
msgstr "%(dev)s не переміщується: жоден пул сховища не містить %(path)s"

#: vrtManager/instance.py:2524
#, python-format
msgid "%(dev)s does not move: it has a backing file"
msgstr "%(dev)s не переміщується: він має базовий файл (backing file)"

#: vrtManager/instance.py:2527
#, python-format
