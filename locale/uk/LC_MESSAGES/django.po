"%(err)s; %(device)s: the VM is not running, its next start does not have it"
msgstr "%(err)s; %(device)s: ВМ не працює, у наступному запуску пристрою немає"

#: vrtManager/instance.py:3204
#, python-format
msgid "%(err)s; %(device)s: the running VM has it, its next start has it"
msgstr "%(err)s; %(device)s: у запущеній ВМ пристрій є, у наступному запуску є"

#: vrtManager/instance.py:3205
#, python-format
msgid ""
"%(err)s; %(device)s: the running VM has it, its next start does not have it"
msgstr ""
"%(err)s; %(device)s: у запущеній ВМ пристрій є, у наступному запуску немає"

#: vrtManager/instance.py:3206
#, python-format
msgid ""
"%(err)s; %(device)s: the running VM does not have it, its next start has it"
msgstr ""
"%(err)s; %(device)s: у запущеній ВМ пристрою немає, у наступному запуску є"

#: vrtManager/instance.py:3208
#, python-format
msgid ""
"%(err)s; %(device)s: the running VM does not have it, its next start does not"
" have it"
msgstr ""
"%(err)s; %(device)s: у запущеній ВМ пристрою немає, у наступному запуску "
"немає"

#: vrtManager/instance.py:3242
#, python-format
msgid "The VM has no PCI device %(address)s"
msgstr "ВМ не має PCI-пристрою %(address)s"

#: vrtManager/instance.py:3263
msgid "The VM has no USB controller"
msgstr "ВМ не має USB-контролера"

#: vrtManager/instance.py:3297
msgid "The VM has no such USB device"
msgstr "ВМ не має такого USB-пристрою"

#: vrtManager/instance.py:3311
#, python-format
msgid "The VM has no network interface %(mac)s"
msgstr "ВМ не має мережевого інтерфейсу %(mac)s"

#: vrtManager/instance.py:3343
msgid "The VM has its own RNG device: change it in the XML editor"
msgstr "ВМ має власний пристрій RNG: змініть його в редакторі XML"

#: vrtManager/instance.py:3370
