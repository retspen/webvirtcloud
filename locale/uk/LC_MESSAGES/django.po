#: vrtManager/interface.py:332 vrtManager/virtsecrets.py:118
#, python-format
msgid "VMs %(names)s"
msgstr "ВМ %(names)s"

#: vrtManager/interface.py:334
#, python-format
msgid "networks %(names)s"
msgstr "мережі %(names)s"

#: vrtManager/interface.py:336
#, python-format
msgid "Interface %(iface)s is used by %(named)s; remove it from them first"
msgstr ""
"Інтерфейс %(iface)s використовується в: %(named)s; спершу приберіть його "
