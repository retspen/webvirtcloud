msgstr ""
"ВМ змінює свої PCI-пристрої, коли працює або вимкнена без збереженого стану"

#: vrtManager/instance.py:3200
#, python-format
msgid "%(err)s; whether the VM has %(device)s now is not known"
msgstr "%(err)s; невідомо, чи має ВМ зараз %(device)s"

#: vrtManager/instance.py:3202
#, python-format
msgid "%(err)s; %(device)s: the VM is not running, its next start has it"
msgstr "%(err)s; %(device)s: ВМ не працює, у наступному запуску пристрій є"

#: vrtManager/instance.py:3203
#, python-format
