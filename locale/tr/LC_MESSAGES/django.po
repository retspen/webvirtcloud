msgstr "Konuk sistemin verilerini koruyan güç işlemleri"

#: instances/templates/instances/power_tab.html:17
msgid "Power On"
msgstr "Başlat"

#: instances/templates/instances/power_tab.html:18
msgid "Power Off"
msgstr "Kapat"

#: instances/templates/instances/power_tab.html:23
msgid "Power On starts the VM."
msgstr "Başlat, sanal makineyi başlatır."

#: instances/templates/instances/power_tab.html:24
msgid "Power Off asks the guest to shut down; the guest decides."
msgstr "Kapat, konuk sistemden kapanmasını ister; karar konuk sisteme aittir."

#: instances/templates/instances/power_tab.html:25
msgid "Resume lets the paused VM run on."
msgstr ""
"Devam ettir, duraklatılmış sanal makinenin çalışmayı sürdürmesini sağlar."

#: instances/templates/instances/power_tab.html:26
msgid "Suspend pauses its vCPUs; the VM stays in memory."
msgstr "Duraklat, vCPU'larını duraklatır; sanal makine bellekte kalır."

