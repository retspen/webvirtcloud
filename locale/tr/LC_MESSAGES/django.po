msgstr "Grafikler"

#: instances/templates/instances/stats_tab.html:26
msgid "of the host"
msgstr "sunucu kapasitesinin"

#: instances/templates/instances/stats_tab.html:28
msgid "CPU use, recent readings"
msgstr "CPU kullanımı, son ölçümler"

#: instances/templates/instances/stats_tab.html:35
msgid "Memory use, recent readings"
msgstr "Bellek kullanımı, son ölçümler"

#: instances/templates/instances/stats_tab.html:44
#, python-format
msgid "Network %(mac)s, recent readings"
msgstr "Ağ %(mac)s, son ölçümler"

#: instances/templates/instances/stats_tab.html:51
#, python-format
msgid "Disk %(dev)s, recent readings"
msgstr "Disk %(dev)s, son ölçümler"

#: instances/templates/instances/stats_tab.html:63
msgid "Date"
msgstr "Tarih"

#: instances/templates/instances/stats_tab.html:73
msgid "The latest rows, newest first."
msgstr "En son satırlar, en yenisi önce."

#: instances/templates/instances/stats_tab.html:74
msgid "All of this VM's logs"
msgstr "Bu sanal makinenin tüm logları"

#: instances/templates/instances/stats_tab.html:85
msgid "The logs could not be loaded."
msgstr "Loglar yüklenemedi."

#: instances/utils.py:63
#, python-format
msgid "The disk files cannot be checked on %(host)s: %(err)s"
msgstr "Disk dosyaları %(host)s üzerinde denetlenemiyor: %(err)s"

