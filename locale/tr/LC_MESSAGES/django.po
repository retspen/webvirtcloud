msgstr ""
"Konuk sistemdeki ajana giden kanal: çalışan bir sanal makine onu hemen alır."

#: instances/templates/instances/settings_tab.html:969
msgid "Agent"
msgstr "Ajan"

#: instances/templates/instances/settings_tab.html:970
