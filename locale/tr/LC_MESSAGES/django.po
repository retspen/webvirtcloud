msgstr "Sanal makine çalışmıyor: hiçbir şey ölçülmüyor."

#: instances/templates/instances/stats_tab.html:14
msgid "Stats view"
msgstr "İstatistik görünümü"

#: instances/templates/instances/stats_tab.html:15
